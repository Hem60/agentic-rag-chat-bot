# ==============================================================================
# .env.example — copy this to .env and fill in your values
# ==============================================================================
# Run: cp .env.example .env   (Linux/Mac)
#      copy .env.example .env  (Windows)

# ------------------------------------------------------------------------------
# HUGGING FACE (required for Inference API mode)
# Get your free token at: https://huggingface.co/settings/tokens
# Create a "Read" token — free, no credit card needed.
# IMPORTANT: For Mistral models, accept the license at:
#   https://huggingface.co/mistralai/Mistral-7B-Instruct-v0.3
# ------------------------------------------------------------------------------
HUGGINGFACEHUB_API_TOKEN=hf_YOUR_TOKEN_HERE

# ------------------------------------------------------------------------------
# Generation model (used for answering questions)
# Options:
#   - mistralai/Mistral-7B-Instruct-v0.3   (requires license acceptance)
#   - Qwen/Qwen2.5-7B-Instruct             (no license required, recommended)
#   - HuggingFaceH4/zephyr-7b-beta         (good alternative)
# Change this without rebuilding Docker — just restart the container.
# ------------------------------------------------------------------------------
GENERATION_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ------------------------------------------------------------------------------
# Embedding model (runs fully locally, no API key needed)
# Downloads automatically on first run (~90 MB)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# Judge model for evaluation (can be same as generation model to save quota)
# ------------------------------------------------------------------------------
JUDGE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ------------------------------------------------------------------------------
# Chunking configuration
# chunk_size: characters per chunk (1000 is a good default for most PDFs)
# chunk_overlap: overlap between chunks to preserve context across boundaries
# ------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ------------------------------------------------------------------------------
# Retrieval configuration
# TOP_K: number of most-relevant chunks to retrieve per question
# ------------------------------------------------------------------------------
TOP_K=4

# ------------------------------------------------------------------------------
# Paths (relative to project root)
# ------------------------------------------------------------------------------
PDF_DIR=data/pdfs
VECTORSTORE_DIR=vectorstore
